---
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---
<header>
	<nav class="topnav">
		<!-- Desktop brand link -->
		<a class="brand-mark u-animlink brand--desktop" href="/" aria-label="Home">
			<span class="brand-bracket" aria-hidden="true">[</span>
			<span class="brand-initials" aria-hidden="true">AT.io</span>
			<span class="brand-bracket" aria-hidden="true">]</span>
		</a>

		<!-- Mobile: brand toggles menu -->
    	<details class="brand-menu brand--mobile">
      	  <summary class="brand-mark u-animlink" aria-label="Open menu">
        	<span class="brand-bracket" aria-hidden="true">[</span>
        	<span class="brand-initials" aria-hidden="true">AT.io</span>
        	<span class="brand-bracket" aria-hidden="true">]</span>
      	  </summary>
		  <div class="internal-links internal-links--dropdown">
        	<HeaderLink href="/">Home</HeaderLink>
      		<HeaderLink href="/blog">Blog</HeaderLink>
        	<HeaderLink href="/photo">Photo</HeaderLink>
        	<HeaderLink href="/about">About</HeaderLink>
        	<HeaderLink href="/contact">Contact</HeaderLink>
      	  </div>
    	</details>

		<!-- Desktop links -->
		<div class="internal-links internal-links--desktop">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/photo">Photo</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<SocialLinks />
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a,
	nav :global(.social-links a) {
		padding: 1em 0.5em;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.topnav {
	  position: relative;
	  display: flex;
	  align-items: center;
	  justify-content: space-between;
	  gap: 1rem;
	}

	/* Default: desktop */
	.brand--mobile { display: none; }
	.internal-links--desktop { display: flex; }

	/* Narrow screens: hide desktop links, show brand dropdown */
	@media (max-width: 400px) {
	  .brand--desktop { display: none; }
	  .internal-links--desktop { display: none; }

	  .brand--mobile { display: block; }

	  /* make the logo toggle match nav link sizing */
      .brand-menu > summary.brand-mark {
        display: inline-flex;
        align-items: center;
        padding: 1em 0.5em;
        border-bottom: 4px solid transparent;
      }

      /* optional: remove any default focus outline weirdness, keep accessible focus */
      .brand-menu > summary.brand-mark:focus-visible {
    	outline: 2px solid rgba(var(--accent), 0.6);
    	outline-offset: 2px;
      }

	  /* remove default triangle marker */
	  .brand-menu > summary {
	    list-style: none;
	    cursor: pointer;
	  }
	  .brand-menu > summary::-webkit-details-marker {
	    display: none;
	  }

	  /* dropdown panel */
	  .internal-links--dropdown {
	    position: absolute;
	    left: 1rem;
	    top: calc(100% + 0.5rem);
	    display: flex;
	    flex-direction: column;
	    gap: 0.75rem;

	    padding: 0.9rem 1rem;
	    border-radius: 12px;
	    background: rgba(10, 10, 10, 0.9);
	    backdrop-filter: blur(10px);

	    /* keep it above content */
	    z-index: 50;
	    min-width: 180px;
	  }
	  .internal-links--dropdown a {
  		color: white;
	  }
	  .internal-links--dropdown a:hover {
  		color: var(--accent);
	  }
	}

	@media (max-width: 720px) {
		nav :global(.social-links) {
			display: none;
		}
	}
</style>
